{
  "tasks": [
    {
      "backend": "openai_http",
      "base_url": "http://127.0.0.1:8000",
      "endpoint": "completion",
      "model": "served-model",
      "request_timeout": 120,
      "task_timeout": 3600,
      "seed": 42,
      "temperature": 0.0,
      "name": "step_capacity",
