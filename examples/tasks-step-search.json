      "num_requests": 5000,
      "max_duration": 900,
      "num_warmups": 8,
      "ignore_eos": true,
      "stop": [],
      "goodput": ["ttft:1000", "tpot:50", "e2el:10000"],
      "stage_min_requests": 30,
      "stage_min_slo_rate": 0.99,
      "stage_min_success_rate": 0.99,
      "stage_max_timeout_rate": 0.01
    }
  ]
