      "ignore_eos": true,
      "stop": []
    },
    {
      "backend": "openai_http",
      "base_url": "http://127.0.0.1:8000",
      "endpoint": "/v1/completions",
      "model": "served-model",
      "request_timeout": 120,
      "task_timeout": 3600,
      "seed": 42,
      "temperature": 0.0,
      "name": "ceval",
      "scenario": "ceval",
      "data": "jsonl",
      "dataset_path": "../dataset/ceval/val.jsonl",
      "template": "ceval",
      "max_samples": 200,
      "shuffle": false,
      "eval_mode": "gen",
      "few_shot": 0,
      "output_tokens": 8,
