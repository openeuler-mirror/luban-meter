    },
    {
      "backend": "openai_http",
      "base_url": "http://127.0.0.1:8000",
      "endpoint": "/v1/completions",
      "model": "served-model",
      "request_timeout": 120,
      "task_timeout": 3600,
      "seed": 42,
      "temperature": 0.0,
      "name": "humaneval",
      "scenario": "humaneval",
      "data": "jsonl",
      "dataset_path": "../dataset/humaneval/HumanEval.jsonl",
      "template": "humaneval",
      "max_samples": 164,
      "shuffle": false,
      "output_tokens": 1024,
      "stop": [
        "\nclass",
        "\ndef",
        "\n#",
        "\nif",
        "\nprint"
